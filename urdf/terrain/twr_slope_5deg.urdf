<?xml version="1.0" encoding="utf-8"?>
<!-- 参考坡面模型：改编自 references/repos/Two-Wheel-Robot-DeepRL/object_models/slope_5deg.urdf，用于 Step3 斜坡反馈测试。 -->
<robot name="twr_slope_5deg">
  <material name="tan">
    <color rgba="0.824 0.706 0.549 1.0"/>
  </material>
  <link name="link_base">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="4.53333333333" ixy="0" ixz="0" iyy="5.20833333333" iyz="0" izz="3.075"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="2.0 2.5 1.2"/>
      </geometry>
      <material name="tan"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="2.0 2.5 1.2"/>
      </geometry>
    </collision>
  </link>

  <link name="link_left">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.833333333333" ixy="0" ixz="0" iyy="1.88133010291" iyz="0" izz="2.70200323042"/>
    </inertial>
    <visual>
      <origin rpy="0 0.0872664625997 0" xyz="0 0 0"/>
      <geometry>
        <box size="6.8842279474 2.5 0.602291902526"/>
      </geometry>
      <material name="tan"/>
    </visual>
    <collision>
      <origin rpy="0 0.0872664625997 0" xyz="0 0 0"/>
      <geometry>
        <box size="6.8842279474 2.5 0.602291902526"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_left" type="fixed">
    <parent link="link_base"/>
    <child link="link_left"/>
    <origin xyz="4.40276909177 0 0"/>
  </joint>

  <link name="link_right">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.833333333333" ixy="0" ixz="0" iyy="1.88133010291" iyz="0" izz="2.70200323042"/>
    </inertial>
    <visual>
      <origin rpy="0 -0.0872664625997 0" xyz="0 0 0"/>
      <geometry>
        <box size="6.8842279474 2.5 0.602291902526"/>
      </geometry>
      <material name="tan"/>
    </visual>
    <collision>
      <origin rpy="0 -0.0872664625997 0" xyz="0 0 0"/>
      <geometry>
        <box size="6.8842279474 2.5 0.602291902526"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_right" type="fixed">
    <parent link="link_base"/>
    <child link="link_right"/>
    <origin xyz="-4.40276909177 0 0"/>
  </joint>
</robot>
