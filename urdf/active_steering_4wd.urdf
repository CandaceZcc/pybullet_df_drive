<?xml version="1.0"?>
<!-- 主动转向四驱车：四轮独立驱动，两个前轮由转向父关节带动车轮旋转子关节。 -->
<robot name="active_steering_4wd">
  <material name="body_red"><color rgba="0.72 0.08 0.12 1"/></material>
  <material name="wheel_dark"><color rgba="0.035 0.035 0.035 1"/></material>
  <material name="knuckle_silver"><color rgba="0.62 0.64 0.68 1"/></material>
  <material name="sensor_gold"><color rgba="0.95 0.68 0.08 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 -0.01"/><mass value="3.84"/><inertia ixx="0.068" ixy="0" ixz="0" iyy="0.171" iyz="0" izz="0.225"/></inertial>
    <visual><origin xyz="0 0 0.01"/><geometry><box size="0.72 0.44 0.14"/></geometry><material name="body_red"/></visual>
    <collision><origin xyz="0 0 0.01"/><geometry><box size="0.72 0.44 0.14"/></geometry></collision>
  </link>

  <link name="front_left_steering_knuckle">
    <inertial><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
    <visual><geometry><box size="0.055 0.055 0.11"/></geometry><material name="knuckle_silver"/></visual>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_left_steering_knuckle"/><origin xyz="0.26 0.25 -0.04"/><axis xyz="0 0 1"/><limit lower="-0.55" upper="0.55" effort="120" velocity="2.0"/><dynamics damping="0.3" friction="0.05"/>
  </joint>
  <link name="front_left_drive_wheel">
    <inertial><mass value="0.45"/><inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0028"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry><material name="wheel_dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry></collision>
  </link>
  <joint name="front_left_drive_wheel_joint" type="continuous"><parent link="front_left_steering_knuckle"/><child link="front_left_drive_wheel"/><axis xyz="0 1 0"/></joint>

  <link name="front_right_steering_knuckle">
    <inertial><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
    <visual><geometry><box size="0.055 0.055 0.11"/></geometry><material name="knuckle_silver"/></visual>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_right_steering_knuckle"/><origin xyz="0.26 -0.25 -0.04"/><axis xyz="0 0 1"/><limit lower="-0.55" upper="0.55" effort="120" velocity="2.0"/><dynamics damping="0.3" friction="0.05"/>
  </joint>
  <link name="front_right_drive_wheel">
    <inertial><mass value="0.45"/><inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0028"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry><material name="wheel_dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry></collision>
  </link>
  <joint name="front_right_drive_wheel_joint" type="continuous"><parent link="front_right_steering_knuckle"/><child link="front_right_drive_wheel"/><axis xyz="0 1 0"/></joint>

  <link name="rear_left_drive_wheel">
    <inertial><mass value="0.45"/><inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0028"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry><material name="wheel_dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry></collision>
  </link>
  <joint name="rear_left_drive_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_drive_wheel"/><origin xyz="-0.26 0.25 -0.04"/><axis xyz="0 1 0"/></joint>
  <link name="rear_right_drive_wheel">
    <inertial><mass value="0.45"/><inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0028"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry><material name="wheel_dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.055"/></geometry></collision>
  </link>
  <joint name="rear_right_drive_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_drive_wheel"/><origin xyz="-0.26 -0.25 -0.04"/><axis xyz="0 1 0"/></joint>

  <!-- 固定视觉挂点明确预留前后雷达和后续双天线安装空间。 -->
  <link name="sensor_deck"><inertial><mass value="0.05"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial><visual><geometry><box size="0.50 0.20 0.035"/></geometry><material name="sensor_gold"/></visual></link>
  <joint name="sensor_deck_joint" type="fixed"><parent link="base_link"/><child link="sensor_deck"/><origin xyz="0 0 0.105"/></joint>
  <link name="lidar_front_mount"><inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial><visual><geometry><box size="0.06 0.12 0.06"/></geometry><material name="sensor_gold"/></visual></link>
  <joint name="lidar_front_mount_joint" type="fixed"><parent link="base_link"/><child link="lidar_front_mount"/><origin xyz="0.34 0 0.105"/></joint>
  <link name="lidar_rear_mount"><inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial><visual><geometry><box size="0.06 0.12 0.06"/></geometry><material name="sensor_gold"/></visual></link>
  <joint name="lidar_rear_mount_joint" type="fixed"><parent link="base_link"/><child link="lidar_rear_mount"/><origin xyz="-0.34 0 0.105"/></joint>
</robot>
